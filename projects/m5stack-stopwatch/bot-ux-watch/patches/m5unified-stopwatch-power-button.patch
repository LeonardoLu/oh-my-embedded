+  bool M5PM1_Class::getButtonPressed(bool* pressed)
+  {
+    if (!_init || pressed == nullptr) return false;
+    std::uint8_t status = 0;
+    if (!readRegister(M5PM1_REG_BTN_STATUS, &status, 1)) return false;
+    *pressed = (status & 0x01) != 0;
+    return true;
+  }
