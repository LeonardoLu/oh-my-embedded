+typedef enum {
+    IDLE_FIELD_DIM_TIMEOUT,
+    IDLE_FIELD_POWEROFF_TIMEOUT,
+    IDLE_FIELD_DIM_CHARGING,
+    IDLE_FIELD_SLEEP_CHARGING,
+} app_settings_idle_field_t;
+
+static esp_err_t app_settings_service_set_idle_field(
+    app_settings_service_handle_t handle, app_settings_idle_field_t field,
+    uint32_t value)
+{
+    ESP_RETURN_ON_FALSE(handle != NULL, ESP_ERR_INVALID_ARG, TAG,
+                        "service missing");
+    ESP_RETURN_ON_FALSE(
+        xSemaphoreTake(handle->lock, pdMS_TO_TICKS(1000)) == pdTRUE,
+        ESP_ERR_TIMEOUT, TAG, "settings service busy");
+    app_system_config_t config;
+    esp_err_t err = app_system_config_load(&config);
+    if (err == ESP_OK) {
+        switch (field) {
+        case IDLE_FIELD_DIM_TIMEOUT:
+            config.dim_timeout_ms = value;
+            break;
+        case IDLE_FIELD_POWEROFF_TIMEOUT:
+            config.poweroff_timeout_ms = value;
+            break;
+        case IDLE_FIELD_DIM_CHARGING:
+            config.dim_while_charging = value != 0U;
+            break;
+        case IDLE_FIELD_SLEEP_CHARGING:
+            config.sleep_while_charging = value != 0U;
+            break;
+        }
+        err = app_system_config_save(&config);
+    }
+    xSemaphoreGive(handle->lock);
+    return err;
+}
+
+esp_err_t app_settings_service_set_dim_timeout(
+    app_settings_service_handle_t handle, uint32_t timeout_ms)
+{
+    ESP_RETURN_ON_FALSE(app_system_config_dim_timeout_valid(timeout_ms),
+                        ESP_ERR_INVALID_ARG, TAG, "invalid dim timeout");
+    return app_settings_service_set_idle_field(
+        handle, IDLE_FIELD_DIM_TIMEOUT, timeout_ms);
+}
+
+esp_err_t app_settings_service_set_poweroff_timeout(
+    app_settings_service_handle_t handle, uint32_t timeout_ms)
+{
+    ESP_RETURN_ON_FALSE(app_system_config_poweroff_timeout_valid(timeout_ms),
+                        ESP_ERR_INVALID_ARG, TAG, "invalid power-off timeout");
+    return app_settings_service_set_idle_field(
+        handle, IDLE_FIELD_POWEROFF_TIMEOUT, timeout_ms);
+}
+
+esp_err_t app_settings_service_set_dim_while_charging(
+    app_settings_service_handle_t handle, bool enabled)
+{
+    return app_settings_service_set_idle_field(
+        handle, IDLE_FIELD_DIM_CHARGING, enabled ? 1U : 0U);
+}
+
+esp_err_t app_settings_service_set_sleep_while_charging(
+    app_settings_service_handle_t handle, bool enabled)
+{
+    return app_settings_service_set_idle_field(
+        handle, IDLE_FIELD_SLEEP_CHARGING, enabled ? 1U : 0U);
