-        for (size_t i = 1U; i < width; ++i) {
-            if (text[offset + i] == '\0' ||
-                    ((unsigned char)text[offset + i] & 0xC0U) != 0x80U) {
-                width = 1U;
-                break;
-            }
-        }
-        offset += width;
-        ++count;
-    }
