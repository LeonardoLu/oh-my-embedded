+esp_err_t app_settings_service_set_idle_dimmed(
+    app_settings_service_handle_t handle, bool dimmed)
+{
+    ESP_RETURN_ON_FALSE(handle != NULL, ESP_ERR_INVALID_ARG, TAG,
+                        "service missing");
+    ESP_RETURN_ON_FALSE(
+        xSemaphoreTake(handle->lock, pdMS_TO_TICKS(1000)) == pdTRUE,
+        ESP_ERR_TIMEOUT, TAG, "settings service busy");
+    esp_err_t err = ESP_OK;
+    if (!handle->user_brightness_ready) {
+        app_system_config_t config;
+        err = app_system_config_load(&config);
+        if (err == ESP_OK) {
+            handle->user_brightness = config.brightness;
+            handle->user_brightness_ready = true;
+        }
+    }
+    if (err == ESP_OK) {
+        uint8_t target =
+            app_settings_brightness_to_hardware(handle->user_brightness);
+        if (dimmed && target > APP_SETTINGS_IDLE_BRIGHTNESS_HW_MAX) {
+            target = APP_SETTINGS_IDLE_BRIGHTNESS_HW_MAX;
+        }
+        err = display_service_set_brightness(target);
+        if (err == ESP_OK) {
+            handle->idle_dimmed = dimmed;
+        }
+    }
+    xSemaphoreGive(handle->lock);
+    return err;
+}
