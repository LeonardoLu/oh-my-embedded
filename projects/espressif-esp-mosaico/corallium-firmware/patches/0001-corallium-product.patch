+def draw_protocol_icon() -> Image.Image:
+    """A monochrome packet between protocol brackets, suitable for tinting."""
+    scale = 4
+    icon = Image.new("RGBA", (48 * scale, 48 * scale), (0, 0, 0, 0))
+    draw = ImageDraw.Draw(icon)
+    color = (255, 255, 255, 255)
+
+    def points(values):
+        return [(x * scale, y * scale) for x, y in values]
+
+    for bracket in (
+            ((15, 11), (8, 11), (8, 37), (15, 37)),
+            ((33, 11), (40, 11), (40, 37), (33, 37))):
+        draw.line(points(bracket), fill=color, width=3 * scale,
+                  joint="curve")
+    draw.rounded_rectangle((18 * scale, 15 * scale, 30 * scale, 33 * scale),
+                           radius=3 * scale, outline=color, width=2 * scale)
+    for y in (21, 27):
+        draw.line(points(((22, y), (26, y))), fill=color, width=2 * scale)
+    return icon.resize((48, 48), LANCZOS)
+
+
+def draw_bluetooth_icon() -> Image.Image:
+    scale = 4
+    icon = Image.new("RGBA", (48 * scale, 48 * scale), (0, 0, 0, 0))
+    draw = ImageDraw.Draw(icon)
+    points = ((14, 15), (34, 32), (24, 40), (24, 8),
+              (34, 16), (14, 33))
+    draw.line([(x * scale, y * scale) for x, y in points],
+              fill=(255, 255, 255, 255), width=3 * scale, joint="curve")
+    return icon.resize((48, 48), LANCZOS)
+
+
+def padded_tint_icon(source: Image.Image) -> Image.Image:
+    """Fit the full silhouette, including antialiasing, inside a safe inset.
+
+    Runtime List resources use the same 48 px opaque tile as their placeholder.
+    Normalizing its alpha mask before encoding avoids cover crops and keeps
+    icon edges away from the slot's damage/clip boundary.
+    """
+    rgba = source.convert("RGBA")
+    # Factory PNGs include black negative-space pixels with nonzero alpha.
+    # Fold luminance into the mask so their holes survive monochrome tinting.
+    alpha = ImageChops.multiply(rgba.getchannel("A"), rgba.convert("L"))
+    maximum = alpha.getextrema()[1]
+    if maximum:
+        alpha = alpha.point(lambda value: round(value * 255 / maximum))
+    bounds = alpha.getbbox()
+    if bounds is None:
+        raise ValueError("Settings icon must have a visible silhouette")
+    silhouette = alpha.crop(bounds)
+    silhouette.thumbnail((34, 34), LANCZOS)
+    mask = Image.new("L", (48, 48), 0)
+    mask.paste(silhouette, ((48 - silhouette.width) // 2,
+                            (48 - silhouette.height) // 2))
+    icon = Image.new("RGBA", mask.size, (214, 214, 222, 0))
+    icon.putalpha(mask)
+    return icon
+
